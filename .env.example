# Sentinel-AI Environment Configuration

# LLM Provider (claude, openai, ollama)
LLM_PROVIDER=claude
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Ollama (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=sentinel_memory

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=60

# Security Product API Keys
PALOALTO_API_KEY=
FORTINET_API_KEY=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
CLOUDFLARE_API_TOKEN=
AWS_WAF_ACCESS_KEY=
AWS_WAF_SECRET_KEY=
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SPLUNK_HEC_TOKEN=

# Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
