# Sentinel-AI Environment Configuration

# LLM Provider (claude, openai, ollama)
LLM_PROVIDER=claude
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Ollama (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=sentinel_memory

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=60

# --- IBM QRadar (on-prem) ---
QRADAR_API_TOKEN=

# --- Palo Alto Firewall ---
PALOALTO_API_KEY=

# --- Microsoft Entra ID (E5) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Microsoft Defender for Endpoint / XDR ---
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=

# --- Microsoft 365 (Exchange Online, Teams, Security Center) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Microsoft Teams Notifications ---
TEAMS_WEBHOOK_URL=

# Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
