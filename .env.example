# Sentinel-AI Environment Configuration
# Copy to .env and fill in values

# === LLM Provider ===
ANTHROPIC_API_KEY=sk-ant-...
# Or for OpenAI:
# OPENAI_API_KEY=sk-...
# Or for local Ollama:
# OLLAMA_BASE_URL=http://localhost:11434

# === Database ===
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai

# === ChromaDB ===
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# === Adapter Credentials ===
# Firewall (Palo Alto)
# PALOALTO_ENDPOINT=https://fw.corp.local
# PALOALTO_API_KEY=

# SIEM (Wazuh)
# WAZUH_ENDPOINT=https://wazuh.corp.local:55000
# WAZUH_USERNAME=
# WAZUH_PASSWORD=

# EDR (CrowdStrike)
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=

# Identity (Entra ID)
# ENTRAID_TENANT_ID=
# ENTRAID_CLIENT_ID=
# ENTRAID_CLIENT_SECRET=

# === Agent Settings ===
DEFAULT_CONFIDENCE_THRESHOLD=0.75
MAX_BLAST_RADIUS=5
SHADOW_MODE=true

# === Observability ===
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
