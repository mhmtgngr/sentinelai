# ── Microsoft Teams ──
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_SECRET=
TEAMS_TENANT_ID=

# ── Email (SMTP) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sentinel@yourorg.com
SMTP_PASSWORD=
SMTP_FROM=sentinel@yourorg.com

# ── Sentinel API ──
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://sentinel.yourorg.com

# ── LLM ──
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── ChromaDB ──
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ── SIEM / Log Sources ──
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=

# ── General ──
LOG_LEVEL=INFO
AUTONOMOUS_MODE=true
AUTO_REMEDIATE=false
REQUIRE_TEAMS_APPROVAL_SEVERITY=high
